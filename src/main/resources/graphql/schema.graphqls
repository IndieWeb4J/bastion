enum PostType {
    NOTE
    ARTICLE
    REPLY
    REPOST
    LIKE
    VIDEO
    PHOTO
    RSVP
}

type Query {
    posts(types: [PostType!], limit: Int = 10, offset: Int = 0, year: Int, month: Int, day: Int): [Post!]!
    post(slug: String, url: String): PostLookup
}

union PostLookup = Post | PostGone

type PostGone {
    slug: String!
    url: String
    published: String
}

type Post {
    id: ID!
    slug: String!
    url: String
    type: String!
    subtype: String
    published: String
    updated: String
    name: String
    summary: String
    content: String
    contentHtml: String
    category: [String!]
    properties(names: [String!]): [Mf2Property!]!
    webmentions: [Webmention!]!
    webmentionCounts: WebmentionCounts!
}

type Mf2Property {
    name: String!
    values: [Mf2Value!]!
}

union Mf2Value = Mf2String | Mf2Boolean | Mf2Number | Mf2Object | Mf2JsonObject | Mf2JsonArray

type Mf2String {
    value: String!
}

type Mf2Boolean {
    value: Boolean!
}

type Mf2Number {
    value: Float!
}

type Mf2Object {
    type: [String!]!
    properties: [Mf2Property!]!
    children: [Mf2Object!]!
}

type Mf2JsonObject {
    fields: [Mf2JsonField!]!
}

type Mf2JsonField {
    name: String!
    value: Mf2JsonValue
}

type Mf2JsonArray {
    values: [Mf2JsonValue]!
}

union Mf2JsonValue = Mf2JsonString | Mf2JsonNumber | Mf2JsonBoolean | Mf2JsonObject | Mf2JsonArray

type Mf2JsonString {
    value: String!
}

type Mf2JsonNumber {
    value: Float!
}

type Mf2JsonBoolean {
    value: Boolean!
}

enum WebmentionInteraction {
    REPLY
    LIKE
    REPOST
    BOOKMARK
    RSVP
    MENTION
}

type Webmention {
    sourceUrl: String!
    targetUrl: String!
    interaction: WebmentionInteraction!
    authorName: String
    authorUrl: String
    authorPhoto: String
    contentText: String
    contentHtml: String
    firstSeenAt: String
    verifiedAt: String
}

type WebmentionCounts {
    total: Int!
    reply: Int!
    like: Int!
    repost: Int!
    bookmark: Int!
    rsvp: Int!
    mention: Int!
}
