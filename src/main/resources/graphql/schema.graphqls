enum PostType {
    NOTE
    ARTICLE
    REPLY
    REPOST
    LIKE
    VIDEO
    PHOTO
    RSVP
}

type Query {
    posts(types: [PostType!], limit: Int = 10, offset: Int = 0, year: Int, month: Int, day: Int): [Post!]!
    post(slug: String, url: String): PostLookup
}

union PostLookup = Post | PostGone

type PostGone {
    slug: String!
    url: String
    published: String
}

type Post {
    id: ID!
    slug: String!
    url: String
    type: String!
    subtype: String
    published: String
    updated: String
    name: String
    summary: String
    content: String
    contentHtml: String
    category: [String!]
    properties(names: [String!]): JSON
    webmentions: [Webmention!]!
    webmentionCounts: WebmentionCounts!
}

enum WebmentionInteraction {
    REPLY
    LIKE
    REPOST
    BOOKMARK
    RSVP
    MENTION
}

type Webmention {
    sourceUrl: String!
    targetUrl: String!
    interaction: WebmentionInteraction!
    authorName: String
    authorUrl: String
    authorPhoto: String
    contentText: String
    contentHtml: String
    firstSeenAt: String
    verifiedAt: String
}

type WebmentionCounts {
    total: Int!
    reply: Int!
    like: Int!
    repost: Int!
    bookmark: Int!
    rsvp: Int!
    mention: Int!
}

scalar JSON
